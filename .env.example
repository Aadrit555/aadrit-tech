# Server-only Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

# Cryptographic secret for signing session cookies (minimum 32 characters)
SESSION_SECRET=replace_with_a_long_random_hex_string_in_production

# Salted hash for admin authentication (PBKDF2-HMAC-SHA256)
# Generate using: node -e "const crypto=require('crypto'); const salt=crypto.randomBytes(16).toString('hex'); console.log(salt + ':' + crypto.pbkdf2Sync('YOUR_PASSWORD', salt, 100000, 32, 'sha256').toString('hex'))"
ADMIN_PASSWORD_HASH=0123456789abcdef:fedcba98765432100123456789abcdef

# CORS & Domain restrictions
ALLOWED_ORIGIN=https://aadrit.dev
SITE_URL=https://aadrit.dev

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

